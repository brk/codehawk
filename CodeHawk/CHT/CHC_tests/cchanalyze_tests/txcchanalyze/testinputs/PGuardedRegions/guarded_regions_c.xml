<?xml version='1.0' encoding='UTF-8'?>
<c-analysis>
  <cfile name="guarded_regions">
    <functions>
      <function name="acquire">
        <parameters>
          <par name="out" nr="1" />
          <par name="size" nr="2" />
        </parameters>
        <postconditions>
          <post>
            <math>
              <apply>
                <initialized-on-return op="ge" value="0" />
                <apply>
                  <addressed-value />
                  <ci>out</ci>
                </apply>
              </apply>
            </math>
          </post>
          <post>
            <math>
              <apply>
                <buffer-on-return op="ge" value="0" />
                <apply>
                  <addressed-value />
                  <ci>out</ci>
                </apply>
                <ci>size</ci>
              </apply>
            </math>
          </post>
        </postconditions>
      </function>
      <function name="readonly_call">
        <parameters />
        <sideeffects>
          <sideeffect>
            <math>
              <apply>
                <preserves-all-memory />
              </apply>
            </math>
          </sideeffect>
        </sideeffects>
      </function>
    </functions>
  </cfile>
</c-analysis>